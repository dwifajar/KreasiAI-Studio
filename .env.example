NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Optional: set to google to use Gemini for script/scene planning. Leave unset to use the zero-cost local planner.
CONTENT_AI_PROVIDER=local
CONTENT_AI_MODEL=gemini-2.5-flash

# Phase 6 - local production renderer
FFMPEG_PATH=
KAI_FONT_FILE=

# Phase 10 - SaaS / Admin
KAI_ADMIN_USER_IDS=
KAI_BILLING_MODE=production
NEXT_PUBLIC_KAI_BILLING_MODE=production
KAI_PAYMENT_PROVIDER=midtrans

# Phase 11 - Midtrans Snap
# Use sandbox first. Switch to production only after sandbox payment + webhook are verified.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
# Optional for future Snap.js popup mode; redirect mode works without it.
MIDTRANS_CLIENT_KEY=
MIDTRANS_EXPIRY_HOURS=24

# Public HTTPS URL used for Midtrans Finish/Error redirects.
# The webhook URL is: https://YOUR_DOMAIN/api/billing/midtrans/notification
# Midtrans cannot call localhost/private/VPN-only notification URLs.
KAI_PUBLIC_URL=https://your-public-domain.example.com
